# Copy to .env and fill in what you need. Everything is optional —
# with no keys the app runs fully offline (OCR + rules, QuickBooks simulator).

COMPANY_NAME=Harbor & Pine Property Management
BASE_CURRENCY=USD
# DATA_DIR=./data

# Review policy
CONFIDENCE_THRESHOLD=0.85
MATH_TOLERANCE=0.02
SECOND_APPROVAL_LIMIT=10000
DUPLICATE_WINDOW_DAYS=10

# Optional AI cross-check of every extraction (anthropic | openai)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=claude-haiku-4-5-20251001

# QuickBooks Online sandbox (developer.intuit.com → your app → Keys & credentials)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
# Option A: click "Connect QuickBooks" in Settings (register this redirect URI in the Intuit app)
QBO_REDIRECT_URI=http://localhost:8000/integrations/quickbooks/callback
# Option B (best on Colab): paste values from Intuit's OAuth 2.0 Playground
QBO_REALM_ID=
QBO_REFRESH_TOKEN=
# Optional: fixed accounts, otherwise the first Expense account is used
QBO_EXPENSE_ACCOUNT_ID=
QBO_TAX_ACCOUNT_ID=

# Email intake (IMAP). For Gmail: imap.gmail.com + an app password
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Only if tesseract isn't on PATH (e.g. Windows)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Hosting (Render / any public URL)
# ACCESS_PASSWORD=choose-a-password   # whole app asks for it (browser sign-in box, any username)
# AUTO_LOAD_DEMO=true                 # load the 5 demo invoices when the database is empty
